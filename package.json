{
  "name": "decky-game-platform-icons",
  "version": "1.1.0",
  "description": "Adds a platform logo (Xbox, PlayStation, Switch, etc.) to the corner of every Steam Deck game card based on the Steam Collection the game belongs to.",
  "type": "module",
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/gen-icons.mjs && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-match.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PacificSilent/decky-game-platform-icons.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "platform",
    "icons",
    "collections"
  ],
  "author": "PacificSilent",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PacificSilent/decky-game-platform-icons/issues"
  },
  "homepage": "https://github.com/PacificSilent/decky-game-platform-icons#readme",
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "react-icons": "^5.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
